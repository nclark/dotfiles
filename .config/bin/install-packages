  glow
  gnupg
  ifstat
  # inxi
  ipcalc
  # jaq
  # jless
  # joplin-cli
  jq
  # jqp
  lazydocker
  localsend
  ntp
  # hugo
  kopia
  lego
  # mas
  mdv
  # minikube
  # musikcube
  fastfetch # neofetch replacement; neofetch was archived upstream and pulled from homebrew-core
  neovim
  # orbstack
  pandoc
  # pass
  progress
  pyenv
  # pillow
  pipx
  pwgen
  qrencode
  # ranger
  rtk
