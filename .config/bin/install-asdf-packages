#!/bin/sh

function install_plugin {
  NAME=$1
  REPO=$2

  if [[ $REPO ]]; then
    URL=$REPO
  else
    URL="https://github.com/asdf-vm/asdf-$NAME.git"
  fi

  if ! asdf plugin list | grep $NAME > /dev/null; then
    asdf plugin add $NAME $URL
  fi
}

function install {
  NAME=$1
  VERSION=$2

  if ! asdf where $NAME $VERSION > /dev/null; then
    asdf install $NAME $VERSION
  fi
}

# Only needed for gems/tools that bind against capstone; skip if it's not
# installed, otherwise the bogus -L path fails every ./configure LDFLAGS check.
if [ -d /opt/homebrew/opt/capstone/lib ]; then
  export LDFLAGS="-L/opt/homebrew/opt/capstone/lib"
  export CPPFLAGS="-I/opt/homebrew/opt/capstone/include"
fi

# --enable-shared builds a libruby dylib; on this macOS/Xcode toolchain that
# dylib ends up tagged arm64 while the ruby binary loading it expects arm64e,
# which breaks building default gems (e.g. rbs) with a dyld arch-mismatch.
# Static linking sidesteps it entirely.
export RUBY_CONFIGURE_OPTS="--disable-shared"

# Newer Clang (Xcode CLT on this macOS) flags Ruby's own bundled ruby.h with
# -Wdefault-const-init-field-unsafe. mkmf's extconf checks compile with
# -Werror, so that warning-as-error spuriously fails checks that merely
# include ruby.h (e.g. ext/socket's IN6_IS_ADDR_UNSPECIFIED probe), which
# then sends extconf down a broken macOS-header-patching fallback path and
# ext/socket silently fails to build. Suppress it at Ruby's own build time so
# it's baked into RbConfig::CONFIG['CFLAGS'] for every future gem/ext build.
export CFLAGS="-Wno-default-const-init-field-unsafe"

asdf plugin add ruby
install ruby 2.7.7
install ruby 3.1.2
asdf set -u ruby 3.1.2

asdf plugin add erlang
install erlang 22.3.4.26
asdf set -u erlang 22.3.4.26

asdf plugin add elixir
install elixir 1.12.3-otp-22
asdf set -u elixir 1.12.3-otp-22

asdf plugin add nodejs
install nodejs 22.17.1
asdf set -u nodejs 22.17.1

install_plugin python https://github.com/asdf-community/asdf-python.git
install python 2.7.18
asdf set -u python 2.7.18
