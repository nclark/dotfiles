#!/bin/sh

function install_plugin {
  NAME=$1
  REPO=$2

  if [[ $REPO ]]; then
    URL=$REPO
  else
    URL="https://github.com/asdf-vm/asdf-$NAME.git"
  fi

  if ! asdf plugin list | grep $NAME > /dev/null; then
    asdf plugin-add $NAME $URL
  fi
}

function install {
  NAME=$1
  VERSION=$2

  if ! asdf where $NAME $VERSION > /dev/null; then
    asdf install $NAME $VERSION
  fi
}

export LDFLAGS="-L/opt/homebrew/opt/capstone/lib"
export CPPFLAGS="-I/opt/homebrew/opt/capstone/include"

asdf plugin add ruby
install ruby 2.7.7
install ruby 3.1.2
asdf set -u ruby 3.1.2

asdf plugin add erlang
install erlang 22.3.4.26
asdf set -u erlang 22.3.4.26

asdf plugin add elixir
install elixir 1.12.3-otp-22
asdf set -u elixir 1.12.3-otp-22

asdf plugin add nodejs
install nodejs 22.17.1
asdf set -u nodejs 22.17.1

install_plugin python https://github.com/asdf-community/asdf-python.git
install python 2.7.18
