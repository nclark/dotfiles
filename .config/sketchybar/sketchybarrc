#!/usr/bin/env sh

# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker
# https://felixkratz.github.io/SketchyBar/config/items
# https://felixkratz.github.io/SketchyBar/config/components#space----associate-mission-control-spaces-with-an-item

source $HOME/.zsh/host

alias s="sketchybar"

PLUGINS="$HOME/.config/sketchybar/plugins"
DEFAULT_ICON_FONT="Hack Nerd Font:Bold:17.0"
DEFAULT_LABEL_FONT="Hack Nerd Font:Bold:14.0"
SPACE_HIGHLIGHT_ICON_COLOR="0xFF00EEFF"
SPACE_ICON_COLOR="0xFFFFFFFF"
SPACE_FONT="Hack Nerd Font:Bold"
SPACE_CLICK="yabai -m space --focus"

s --add event yabai_window

s -m --add event window_focus \
     --add event title_change

s --bar height=33                            \
        position=top                         \
        padding_left=15                      \
        padding_right=2                      \
        color=0xB3333333                     \
        border_color=0xff000000              \
        border_width=0                       \
        y_offset=-2                          \
        margin=-2                            \
                                             \
  --default updates=when_shown               \
            drawing=on                       \
            icon.font="$DEFAULT_ICON_FONT"   \
            icon.color=0xffffffff            \
            label.font="$DEFAULT_LABEL_FONT" \
            label.color=0xffffffff           \
            label.padding_left=4             \
            label.padding_right=4            \
            icon.padding_left=8              \
            icon.padding_right=8

if [ "${WORK_MACHINE}" = "true" ]; then
  SPACES="browser,1,
        slack,2,
        code,3,
        trello,4,
        personal,5,
        prod,6,
        comm,7,"
else
  SPACES="browser,1,
        terminal,2,
        misc,3,
        prod,4,,
        gpt,5,"
fi

for i in $SPACES
do
  NAME=`echo $i | cut -d"," -f1`
  NUMBER=`echo $i | gcut -d"," -f2`
  ICON=`echo $i | gcut -d"," -f3-10 | sed -e "s/,/ /g"`
  WORK_MACHINE=$(yadm-context --work)

  if [ $WORK_MACHINE == true -a $NUMBER == 7 ] || [ ! $WORK_MACHINE == true -a $NUMBER == 5 ]; then
    LABEL=""
  else
    LABEL=""
  fi

  s --add space $NAME left                             \
    --set $NAME associated_display=1                   \
    associated_space=$NUMBER                           \
    label=""                                          \
    label.color=$SPACE_ICON_COLOR                      \
    label.padding_right=10                             \
    icon="$NUMBER $ICON "                              \
    icon.font="$SPACE_FONT:14.0"                       \
    icon.color=$SPACE_ICON_COLOR                       \
    icon.highlight_color=$SPACE_HIGHLIGHT_ICON_COLOR   \
    click_script="$SPACE_CLICK $NUMBER"
done

# Launch-mode glow: skhd leader mode (cmd - ;) lights up the bar and lists
# the chords here. Fired by ~/bin/skhd-leader.
s --add event skhd_mode                                   \
  --add item  skhd_mode center                            \
  --set skhd_mode drawing=off                             \
                  updates=on                              \
                  script="$PLUGINS/skhd_mode.sh"          \
                  icon="󱓞"                                \
                  icon.color=0xfffaa968                   \
                  label.color=0xfff6dcac                  \
                  label.font="Hack Nerd Font:Bold:14.0"   \
  --subscribe skhd_mode skhd_mode

s -m --add item title left                         \
     --set title script="$PLUGINS/window_title.sh" \
     --subscribe title window_focus                \
                       front_app_switched          \
                       space_change                \
                       title_change

# note: sketchybar --query default_menu_items

# Outlook, ownCloud, MeetingBar, and BusyCal's alias were all tried for the
# calendar slot and all failed identically -- sketchybar's alias feature can
# locate/size text-based menu items but never renders their captured
# content (only works for plain icons, e.g. Amphetamine below). Replaced
# with next_event.rb, which polls $ENOVIS_ICS_URL directly instead of
# capturing anything.
# Order added determines left-to-right position within the right-side
# cluster (last added ends up leftmost), so clock goes first to land:
# next_event, Amphetamine, Clock.
s --add item  clock right                \
  --set clock update_freq=10             \
              script="$PLUGINS/clock.sh" \
              label.padding_left=0       \
              icon.padding_left=0

# ┊ divider between the clock and the icons. Clock + this divider = 199 px,
# which with the bar's right edge at the screen edge (padding_right=2, margin
# -2) ends exactly where the real Battery icon ends (x=1849 on the built-in
# 2048-pt display). Keep it, or add a spacer of the difference.
s --add item  amphetamine_sep right     \
  --set amphetamine_sep icon.drawing=off \
                         label="┊"

# Mirror of the real (hidden) menu bar, so each icon sits exactly under the
# real one when the menu bar slides down. Order and widths copied from the
# real bar, right to left: Battery, Bluetooth, [WireGuard -> Sound popup], Weather,
# CleanShot, Weather, FluidVoice, Amphetamine.
#
# Third-party items are reported as "Control Center,Item-0(N)"; N is the
# item's rank counting right-to-left across the real menu bar (Clock=1).
# The numbering shifts as apps quit/launch, so menubar_sync.sh resolves it
# by app (via ~/.local/bin/menubar-map) instead of hard-coding N. Wi-Fi hidden. If icons swap or
# drift, re-check with `sketchybar --query default_menu_items`
# (cmd-dragging icons in the real menu bar or relaunching an app can
# reshuffle N). Aliases draw 2 px wider than the real item, hence the
# -1 paddings. (History: SwiftUI items rendered blank on older Tahoe /
# sketchybar 2.24.0; they render fine on macOS 26.7.3 + 2.24.1.)
# The mirrored row itself (Battery, Time Machine, Bluetooth, Weather,
# CleanShot, FluidVoice, Amphetamine, plus gaps for anything else) is built
# by plugins/menubar_sync.sh at the bottom of this file, by position.

# Sound: sits over WireGuard's slot in the real bar (WireGuard is only there
# as a 38 px placeholder). Click for a popup of every output and input
# device; click one to switch.
s --add item  sound right                                   \
  --set sound icon="󰕾"                                      \
              label.drawing=off                             \
              width=38                                      \
              icon.width=38                                 \
              icon.align=center                             \
              icon.padding_left=0                           \
              icon.padding_right=0                          \
              script="$PLUGINS/sound.sh"                    \
              popup.align=right                             \
              popup.background.color=0xff222222             \
              popup.background.corner_radius=8              \
              popup.background.border_width=1               \
              popup.background.border_color=0xff444444      \
  --subscribe sound mouse.clicked mouse.exited.global




# OFF (calendar on e-ink display): s --add item  next_event right                         \
# OFF (calendar on e-ink display):   --set next_event update_freq=5                       \
# OFF (calendar on e-ink display):                     script="$PLUGINS/next_event.sh"     \
# OFF (calendar on e-ink display):                     click_script="$PLUGINS/next_event_click.sh" \
# OFF (calendar on e-ink display):                     label.padding_left=0                \
# OFF (calendar on e-ink display):                     icon.padding_left=0

# Lock + app name while an app holds Secure Event Input (which blinds skhd).
# Hidden otherwise. updates=on is required: the default when_shown would
# never run the script again once the item is hidden.
s --add item  secure_input right                        \
  --set secure_input update_freq=2                      \
                     updates=on                         \
                     drawing=off                        \
                     script="$PLUGINS/secure_input.sh"  \
                     icon=""                           \
                     icon.color=0xffeb6f92              \
                     label.color=0xffeb6f92

# update_freq only triggers on the next tick, not immediately -- without
# this, the item sits blank for up to 60s after every sketchybar restart.
# OFF (calendar on e-ink display): NAME=next_event "$PLUGINS/next_event.sh" &

# Keep the mirrored icons pointing at the right real icons (see
# plugins/menubar_sync.sh). Runs now, every 60 s, on wake, and when yabai
# reports an app launching or quitting (`sketchybar --trigger menubar_changed`).
rm -f "$HOME/.cache/sketchybar/menubar_sync.state"
s --add event menubar_changed
s --add item  menubar_sync right                     \
  --set menubar_sync drawing=off                     \
                     updates=on                      \
                     update_freq=60                  \
                     script="$PLUGINS/menubar_sync.sh" \
  --subscribe menubar_sync menubar_changed system_woke
"$PLUGINS/menubar_sync.sh"
