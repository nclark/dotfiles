  asmvik/formulae
  felixkratz/formulae
  xwmx/taps
  heroku/brew
  noahgorstein/tap
  clangen/musikcube
  localsend/localsend
)

declare -a PACKAGES=(
  age
  # android-platform-tools
  amazon-ecs-cli
  asdf
  awscli
  b2-tools
  bash-completion
  # basictex
  bitwarden-cli
  broot
  busycal
  choose-gui
  cloudflared
  colima
  coreutils
  direnv
  # dust
  fd
  # fx
  fzf
  gh
