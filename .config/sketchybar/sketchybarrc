#!/usr/bin/env sh

# https://felixkratz.github.io/SketchyBar/config/tricks#color-picker
# https://felixkratz.github.io/SketchyBar/config/items
# https://felixkratz.github.io/SketchyBar/config/components#space----associate-mission-control-spaces-with-an-item

source $HOME/.zsh/host

alias s="sketchybar"

PLUGINS="$HOME/.config/sketchybar/plugins"
DEFAULT_ICON_FONT="Hack Nerd Font:Bold:17.0"
DEFAULT_LABEL_FONT="Hack Nerd Font:Bold:14.0"
SPACE_HIGHLIGHT_ICON_COLOR="0xFF00EEFF"
SPACE_ICON_COLOR="0xFFFFFFFF"
SPACE_FONT="Hack Nerd Font:Bold"
SPACE_CLICK="yabai -m space --focus"

s --add event yabai_window

s -m --add event window_focus \
     --add event title_change

s --bar height=33                            \
        position=top                         \
        padding_left=15                      \
        padding_right=20                     \
        color=0xB3333333                     \
        border_color=0xff000000              \
        border_width=0                       \
        y_offset=-2                          \
        margin=-2                            \
                                             \
  --default updates=when_shown               \
            drawing=on                       \
            icon.font="$DEFAULT_ICON_FONT"   \
            icon.color=0xffffffff            \
            label.font="$DEFAULT_LABEL_FONT" \
            label.color=0xffffffff           \
            label.padding_left=4             \
            label.padding_right=4            \
            icon.padding_left=8              \
            icon.padding_right=8

if [ "${WORK_MACHINE}" = "true" ]; then
  SPACES="browser,1,
        slack,2,
        code,3,, 
        trello,4,
        personal,5,
        prod,6,,
        comm,7,,,"
else
  SPACES="browser,1,
        terminal,2,
        misc,3,
        prod,4,,
        gpt,5,"
fi

for i in $SPACES
do
  NAME=`echo $i | cut -d"," -f1`
  NUMBER=`echo $i | gcut -d"," -f2`
  ICON=`echo $i | gcut -d"," -f3-10 | sed -e "s/,/ /g"`
  WORK_MACHINE=$(yadm-context --work)

  if [ $WORK_MACHINE == true -a $NUMBER == 7 ] || [ ! $WORK_MACHINE == true -a $NUMBER == 5 ]; then
    LABEL=""
  else
    LABEL=""
  fi

  s --add space $NAME left                             \
    --set $NAME associated_display=1                   \
    associated_space=$NUMBER                           \
    label=""                                          \
    label.color=$SPACE_ICON_COLOR                      \
    label.padding_right=10                             \
    icon="$NUMBER $ICON "                              \
    icon.font="$SPACE_FONT:14.0"                       \
    icon.color=$SPACE_ICON_COLOR                       \
    icon.highlight_color=$SPACE_HIGHLIGHT_ICON_COLOR   \
    click_script="$SPACE_CLICK $NUMBER"
done

s -m --add item title left                         \
     --set title script="$PLUGINS/window_title.sh" \
     --subscribe title window_focus                \
                       front_app_switched          \
                       space_change                \
                       title_change

# note: sketchybar --query default_menu_items

# Outlook, ownCloud, MeetingBar, and BusyCal's alias were all tried for the
# calendar slot and all failed identically -- sketchybar's alias feature can
# locate/size text-based menu items but never renders their captured
# content (only works for plain icons, e.g. Amphetamine below). Replaced
# with next_event.rb, which polls $ENOVIS_ICS_URL directly instead of
# capturing anything.
# Order added determines left-to-right position within the right-side
# cluster (last added ends up leftmost), so clock goes first to land:
# next_event, Amphetamine, Clock.
s --add item  clock right                \
  --set clock update_freq=10             \
              script="$PLUGINS/clock.sh" \
              label.padding_left=0       \
              icon.padding_left=0

# Amphetamine is a captured icon with no editable label of its own, so the
# ┊ divider between it and the clock needs its own standalone item.
s --add item  amphetamine_sep right     \
  --set amphetamine_sep icon.drawing=off \
                         label="┊"

s --add alias "Control Center,Amphetamine" right          \
  --set "Control Center,Amphetamine" icon.padding_left=0  \
                                      icon.padding_right=0 \
                                      label.padding_left=0 \
                                      label.padding_right=0

# CleanShot X and FluidVoice both link SwiftUI.framework (confirmed via
# otool -L), unlike Amphetamine which has zero SwiftUI linkage. That's the
# real dividing line: sketchybar's alias capture only works for classic
# AppKit NSStatusItem icons, not SwiftUI MenuBarExtra ones -- same root
# cause as Outlook/MeetingBar/BusyCal above, just confirmed definitively
# this time. Not fixable from the config side; dropped both.

s --add item  next_event right                         \
  --set next_event update_freq=5                       \
                    script="$PLUGINS/next_event.sh"     \
                    click_script="$PLUGINS/next_event_click.sh" \
                    label.padding_left=0                \
                    icon.padding_left=0

# update_freq only triggers on the next tick, not immediately -- without
# this, the item sits blank for up to 60s after every sketchybar restart.
NAME=next_event "$PLUGINS/next_event.sh" &

