. $HOME/.zsh/host

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa

yabai -m config layout stack
yabai -m config window_shadow float

yabai -m config window_opacity on
yabai -m config active_window_opacity 1.0
yabai -m config normal_window_opacity 0.98

yabai -m config external_bar all:38:0
yabai -m config bottom_padding 5
yabai -m config left_padding 5
yabai -m config right_padding 5
yabai -m config window_gap 6

yabai -m config focus_follows_mouse autofocus
yabai -m config mouse_modifier ctrl
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize

# App specific rules
## grid: <rows>:<cols>:<start-x>:<start-y>:<width>:<height>

yabai -m rule --add app="^Fantastical Helper$" manage=off
yabai -m rule --add app="^choose$" manage=off
yabai -m rule --add title="^Command Help$" manage=off
yabai -m rule --add title="^Quick Entry$" manage=off grid=6:4:1:1:2:2
# yabai -m rule --add app="^Mail$" manage=on
yabai -m rule --add app="^Finder$" manage=on
yabai -m rule --add app="^Finder$" title="^Copy$" manage=off
yabai -m rule --add app="^Finder$" title="^Move$" manage=off

# Force Outlook to tile
yabai -m rule --add app="^Microsoft Outlook$" manage=on
# Force Teams to tile
yabai -m rule --add app="^Microsoft Teams$" manage=on
# Keep the meeting compact overlay from stalking across desktops
yabai -m rule --add app="^Microsoft Teams$" title="compact view" manage=off sticky=off
yabai -m signal --add app="^Microsoft Teams$" event=window_created title="compact view" action="yabai -m window \$YABAI_WINDOW_ID --minimize"
yabai -m signal --add app="^Microsoft Teams$" event=window_title_changed title="compact view" action="yabai -m window \$YABAI_WINDOW_ID --minimize"
# Keep Outlook preferences and small dialogs floating
yabai -m rule --add app="^Microsoft Outlook$" title="^Preferences$" manage=off
yabai -m rule --add app="^Microsoft Outlook$" title="^Settings$" manage=off
yabai -m rule --add app="^Microsoft Outlook$" title="^About Microsoft Outlook$" manage=off

# Ghostty tab workaround: native tabs report as separate windows, re-apply layout
yabai -m signal --add app='^Ghostty$' event=window_created action='yabai -m space --layout bsp'
yabai -m signal --add app='^Ghostty$' event=window_destroyed action='yabai -m space --layout bsp'

# SketchyBar events
yabai -m signal --add event=window_focused action="sketchybar -m --trigger window_focus &> /dev/null"
yabai -m signal --add event=window_title_changed action="sketchybar -m --trigger title_change &> /dev/null"

