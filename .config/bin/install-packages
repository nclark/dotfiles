  terraform
  terraform-ls
  # timg
  wireguard-tools
  wget
)

declare -a PERSONAL_PACKAGES=(
  kopia
  nicotine-plus
)

declare -a WORK_PACKAGES=(
  # heroku
  # ical-buddy
  # oath-toolkit
  saml2aws
  session-manager-plugin
)

declare -a CASKS=(
  balenaetcher
  # bettertouchtool
  # biscuit
  # bitwarden
  # chatgpt
  claude
  cleanshot
  # dash
  drawio
  # fantastical
  # finch
  # fluid
  # flux
  font-anonymous-pro
  font-bitstream-vera-sans-mono-nerd-font
  font-hack-nerd-font
  # fork
  # freetube
  # iina
  istat-menus
  # joplin
  karabiner-elements
  keyboardcleantool
  kitty
  # kopiaui
  # lagrange
  # meetingbar
  monodraw
  # nextcloud
  numi
  # obsidian
  # orion
  # plexamp
  # postman
  qlvideo
  slack
  tableplus
  textmate
  the-unarchiver
  # time-out
  tolaria
  # tor-browser
  transmit
  vimr
)

declare -a CASKS_NO_QUARANTINE=(
  eloston-chromium
  librewolf
  middleclick
)

declare -a PERSONAL_CASKS=(
  calibre
  musicbrainz-picard
  signal
  sonixd
  telegram-desktop
  tor-browser
)

declare -a WORK_CASKS=(
  tunnelblick
  zoom
)

declare -a PIP_PACKAGES=(
  opn-cli
)

function install_if_missing {
  if ! echo $VERSIONS | grep $1 > /dev/null ; then brew install $1; fi
}

function install_cask_if_missing {
  if ! echo $INSTALLED_CASKS | grep $1 > /dev/null ; then
    brew install --cask $1
    # Homebrew dropped --no-quarantine (removed as of brew 4.7+); strip the
    # quarantine xattr manually afterwards for casks that need it (unsigned/
    # unnotarized apps that would otherwise be blocked by Gatekeeper).
    if [[ -n "$2" && $2 == "no-quarantine" ]]; then
      xattr -r -d com.apple.quarantine "$(brew --prefix)/Caskroom/$1" 2>/dev/null
    fi
  fi
}

VERSIONS=$(brew ls --versions)

INSTALLED_CASKS=$(brew ls --casks)

for i in ${TAPS[@]}; do
  if ! [ -d "$(brew --prefix)/Library/Taps/$(dirname $i)" ]; then brew tap $i; fi
  # Trust every tap we manage so brew's tap-trust check doesn't warn/block.
  # Only trust taps you actually vetted and added to TAPS above.
  brew trust --tap $i > /dev/null
done

for i in ${PACKAGES[@]}; do
  install_if_missing $i
done

for i in ${CASKS[@]}; do
  install_cask_if_missing $i
done

for i in ${CASKS_NO_QUARANTINE[@]}; do
  install_cask_if_missing $i no-quarantine
done

if yadm-context --work; then
  for i in ${WORK_PACKAGES[@]}; do
    install_if_missing $i
  done

  for i in ${WORK_CASKS[@]}; do
    install_cask_if_missing $i
  done
fi

if yadm-context --personal; then
  for i in ${PERSONAL_PACKAGES[@]}; do
    install_if_missing $i
  done

  for i in ${PERSONAL_CASKS[@]}; do
    install_cask_if_missing $i
  done
fi

for i in ${PIP_PACKAGES[@]}; do
  pipx install $i
done
